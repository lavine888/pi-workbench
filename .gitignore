# Exact public candidate allowlist. Unlisted files stay local.
# Synchronize with public/manifest.json; never use force-add for private data.
/*
!/.gitignore
!/README.md
!/docs/
/docs/*
!/docs/INSTALLATION.md
!/docs/PROJECT_STRUCTURE.md
!/docs/PROVENANCE.md
!/docs/PUBLIC_RELEASE.md
!/docs/THIRD_PARTY_NOTICES.md
!/docs/USAGE.md
!/public/
/public/*
!/public/manifest.json
!/public/agents/
/public/agents/*
!/public/agents/planner.md
!/public/agents/reviewer.md
!/public/agents/scout.md
!/public/agents/worker.md
!/public/examples/
/public/examples/*
!/public/examples/APPEND_SYSTEM.md
!/public/examples/memory.synthetic.json
!/public/examples/settings.example.json
!/public/extensions/
/public/extensions/*
!/public/extensions/deepseek-harness.ts
!/public/extensions/subagent/
/public/extensions/subagent/*
!/public/extensions/subagent/agents.ts
!/public/extensions/subagent/index.ts
!/public/extensions/subagent/subagent-client.ts
!/public/extensions/subagent/subagent-server.ts
!/public/licenses/
/public/licenses/*
!/public/licenses/PI-MIT.txt
!/public/prompts/
/public/prompts/*
!/public/prompts/debug.md
!/public/prompts/document.md
!/public/prompts/implement-and-review.md
!/public/prompts/implement.md
!/public/prompts/refactor.md
!/public/prompts/scout-and-plan.md
!/public/prompts/test.md
!/scripts/
/scripts/*
!/scripts/prepare-public-release.py
/.local-audit/
